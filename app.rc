#pragma code_page(65001)
1 ICON "@ICON_PATH@"
1 VERSIONINFO
 FILEVERSION @VERSION_NUMERIC@
 PRODUCTVERSION @VERSION_NUMERIC@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "@DISPLAY_NAME@"
            VALUE "InternalName", "@PACKAGE_NAME@"
            VALUE "OriginalFilename", "@PACKAGE_NAME@.exe"
            VALUE "ProductName", "@DISPLAY_NAME@ @PACKAGE_NAME@"
            VALUE "ProductVersion", "@VERSION@"
            VALUE "FileVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
